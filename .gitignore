# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# reference clone of daedalOS (DustinBrett) — features ported from here
/daedalOS-reference
/daedalOS-reference/**

# secondary / cloned reference repositories (untracked, not committed)
/reference-repos
/reference-repos/**
/external-projects
/external-projects/**
/third-party
/third-party/**


# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
